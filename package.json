{
  "name": "giser-convert-crs",
  "version": "1.0.2",
  "description": "China CRS geometry conversion library for WGS-84, GCJ-02, BD-09, EPSG:3857, CGCS2000, GeoJSON and WKT.",
  "main": "dist/giserConvertCrs.umd.js",
  "module": "dist/giserConvertCrs.esm.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/giserConvertCrs.esm.js",
      "require": "./dist/giserConvertCrs.umd.js",
      "default": "./dist/giserConvertCrs.esm.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node scripts/clean.js && rollup -c && node scripts/copy-types.js",
    "dev": "rollup -c -w",
    "test": "node --test scripts/test.js",
    "bench": "node --expose-gc scripts/bench.js",
    "prepack": "npm run build"
  },
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^28.0.0",
    "@rollup/plugin-node-resolve": "^16.0.0",
    "@rollup/plugin-terser": "^1.0.0",
    "rollup": "^4.28.0"
  },
  "keywords": [
    "coordinate",
    "transform",
    "wgs84",
    "gcj02",
    "bd09",
    "epsg3857",
    "cgcs2000",
    "wkt",
    "geojson"
  ],
  "author": "",
  "license": "MIT"
}
